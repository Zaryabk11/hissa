{
  "expo": {
    "name": "Hissa",
    "slug": "hissa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hissa.app"
    },
    "android": {
      "package": "com.hissa.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "hissa",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Hissa uses the camera to look at your plate. Photos stay on your phone until you confirm a meal.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hissa reads the photo you pick so it can look at your plate."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "790edd6d-4dce-46b4-a828-67211ce8d5a3"
      }
    },
    "owner": "zaryab_t"
  }
}
