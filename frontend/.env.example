# Expo only exposes variables prefixed EXPO_PUBLIC_ to the app. Never put secrets here.
# They are baked into the app bundle when it is built or started, so restart Expo after a change.
# EAS builds do not read this file (it is git-ignored). For the APK, create the same three names
# as EAS environment variables for the `preview` environment (see docs/release-v2.md).

# Base URL of the Hissa API. Phone: your computer's LAN address. Android emulator: http://10.0.2.2:3000.
# Release build: the public HTTPS URL of the deployed API.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Supabase project URL (https://<project-ref>.supabase.co).
EXPO_PUBLIC_SUPABASE_URL=
# Use a publishable key or legacy anon key, never a service-role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Allow hissa://** in Supabase Auth redirect URLs; Google redirects to Supabase first.
