# Expo only exposes variables prefixed EXPO_PUBLIC_ to the app. Never put secrets here.
# Android emulator reaches the host machine at 10.0.2.2; a physical phone needs your LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=
# Use a publishable key or legacy anon key, never a service-role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Allow hissa:// in Supabase Auth redirect URLs; Google redirects to Supabase first.
