{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "lint": "eslint . && tsc --noEmit",
    "train:questions": "tsx scripts/train-question-ranker.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "express": "^5.3.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
