# Backend only. Never commit real values. On a host (for example Railway) set these as service variables.

# Port the API listens on (hosts such as Railway inject their own).
PORT=3000
# Supabase project URL and keys (Project Settings, API).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret service-role key: bypasses RLS. Server only, never in the app.
SUPABASE_SERVICE_ROLE_KEY=
# Google AI Studio key for Gemini (names dishes and words check-in questions; never gives calories).
GEMINI_API_KEY=
# Optional: override the default model. Leave the line out or blank to use the default.
GEMINI_MODEL=gemini-flash-lite-latest
# Optional: per-call Gemini timeout in milliseconds.
GEMINI_TIMEOUT_MS=10000
# Optional: scans allowed per user per day.
SCAN_DAILY_CAP=10
# Optional. Leave empty. A demo-only account's user id: only it may show sample-labelled data.
DEMO_USER_ID=
