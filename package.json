{
  "name": "hissa",
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w backend",
    "dev:app": "npm run start -w frontend",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "test:data": "node --test database/scripts/*.test.mjs",
    "start": "npm start -w backend"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
